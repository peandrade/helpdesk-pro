generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updateAt  DateTime  @updatedAt
  ticketsCreated   Ticket[] @relation("CreatedTickets")
  ticketsAssigned   Ticket[] @relation("AssignedTickets")
  role      Role  @default(USER)
}

model Ticket {
  id        String    @id @default(cuid())
  title      String
  description     String
  createdAt DateTime  @default(now())
  updateAt  DateTime  @updatedAt
  createdBy      User        @relation(name: "CreatedTickets", fields: [createdById], references: [id])
  assignedTo     User?       @relation(name: "AssignedTickets", fields: [assignedById], references: [id])
  category       Category?   @relation(fields: [categoryId], references: [id])
  createdById    String
  assignedById   String?
  categoryId     String? 
  status    Status    @default(OPEN)
  priority  Priority  @default(LOW)
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum Status {
  OPEN
  CLOSED
  RESOLVED
  IN_PROGRESS
  WAITING_USER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Category {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  isActive  Boolean   @default(true)
  ticket    Ticket[]
}

model Comment {

}

model TicketHistory {
  
}